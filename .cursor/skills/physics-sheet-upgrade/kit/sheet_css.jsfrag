    +'.ps-sec{margin:26px 0;padding-top:4px;}'
    +'.ps-h{display:flex;align-items:baseline;gap:12px;margin:0 0 12px;padding-bottom:9px;border-bottom:1px solid var(--line);}'
    +'.ps-no{font:600 20px/1 "STIX Two Text",Georgia,serif;color:var(--acc);}'
    +'.ps-h h3{margin:0;font:600 21px/1.25 "STIX Two Text",Georgia,serif;}'
    +'.ps-sub{margin:18px 0 6px;font:600 16px/1.3 "STIX Two Text",Georgia,serif;}'
    +'.ps-p{font-size:13.5px;color:var(--mut);}.ps-p b{color:var(--ink);}'
    +'.ps-glance{display:grid;grid-template-columns:1fr 1fr;gap:14px;align-items:start;}@media(max-width:620px){.ps-glance{grid-template-columns:1fr;}}'
    +'.ps-card{border:1px solid var(--line);border-radius:10px;padding:12px 14px;background:var(--card);}.ps-card h4{margin:0;font:600 15px "STIX Two Text",Georgia,serif;}'
    +'.fig.f0{margin:0;}.fig.f0 svg{max-width:320px;}'
    +'.ps-keys{list-style:none;padding:0;font-size:13.5px;color:var(--mut);}.ps-keys li{position:relative;padding-left:30px;margin:7px 0;}.ps-keys b{color:var(--ink);}'
    +'.ps-chip{position:absolute;left:0;top:.72em;width:18px;height:0;border-top:3px solid;}.ps-chip.ps-dash{border-top-style:dashed;}.ps-chip.ps-box{top:.4em;left:3px;height:9px;width:12px;border:1.5px solid var(--soft);border-radius:3px;}'
    +'.ps-key{margin:12px 0;padding:11px 14px;border-radius:9px;background:var(--tint);border:1px solid var(--acc-soft);font-size:13.5px;}'
    +'.ps-note{font-size:12px;color:var(--soft);}'
    +'.ps-ctl,.ps-num{width:100%;border-collapse:collapse;font-size:13px;color:var(--mut);margin:8px 0;}.ps-ctl th,.ps-num th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--soft);padding:6px 8px;border-bottom:1px solid var(--line);}.ps-ctl td,.ps-num td{padding:7px 8px;border-bottom:1px solid var(--line);vertical-align:top;}.ps-ctl b{color:var(--ink);}.ps-num td{color:var(--ink);font-family:ui-monospace,monospace;font-size:12.5px;}'
    +'.ps-deep{margin:14px 0 0;border:1px solid var(--line);border-radius:9px;padding:9px 12px;}.ps-deep summary{font-weight:600;}'
    +'.ps-myth{list-style:none;padding:0;font-size:13.5px;color:var(--mut);}.ps-myth li{margin:7px 0;padding-left:12px;border-left:2px solid var(--line);}.ps-myth span{display:block;color:var(--ink);font-style:italic;}'
    +'@media print{.ps-sec{break-inside:auto;}.ps-h{break-after:avoid;}}'
